{
  "name": "playwright-qa-automation-portfolio",
  "version": "1.0.0",
  "description": "Playwright and TypeScript QA automation portfolio",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --workers=1",
    "test:chromium": "playwright test --project=chromium --workers=1",
    "test:smoke": "playwright test --project=chromium --workers=1 --grep \"@smoke\"",
    "test:regression": "playwright test --project=chromium --workers=1 --grep \"@regression\"",
    "test:headed": "playwright test --project=chromium --headed --workers=1",
    "test:smoke:firefox": "playwright test --project=firefox --workers=1 --grep \"@smoke\"",
    "test:smoke:webkit": "playwright test --project=webkit --workers=1 --grep \"@smoke\"",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa",
    "automation",
    "testing"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "dotenv": "^18.0.1"
  }
}